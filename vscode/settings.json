{
    "workbench.colorTheme": "Monokai",
    "terminal.external.osxExec": "iTerm.app",
    "workbench.startupEditor": "newUntitledFile",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": false,
    "files.exclude": {
        "**/.git": false,
        "**/.yarn": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/*.swp": true,
        "**/*.gitkeep": true,
        "**/*.keep": true,
        "**/.DS_Store": true
    },
    "diffEditor.ignoreTrimWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "editor.renderWhitespace": "boundary",
    "editor.scrollBeyondLastLine": false,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "extensions.ignoreRecommendations": false,
    "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 13,
    "editor.experimentalEditContextEnabled": false,
    "editor.editContext": false,
    "terminal.integrated.fontSize": 13,
    "editor.tabSize": 2,
    "editor.minimap.enabled": false,
    "vim.insertModeKeyBindings": [
        {
            "before": ["<C-f>"],
            "after": ["<Esc>"]
        }
    ],
    "vim.normalModeKeyBindings": [
        {
            "before": [";"],
            "after": [":"]
        },
        {
            "before": ["<space>","n"],
            "commands": [":tabn"]
        },
        {
            "before": ["<space>","p"],
            "commands": [":tabp"]
        }
    ],
    "files.eol": "\n",
    "git.autofetch": true,
    "sass.disableAutoIndent": true,
    "tabnine.experimentalAutoImports": true,
    "workbench.iconTheme": "material-icon-theme",
    "vim.commandLineModeKeyBindings": [

    ],
    "omnisharp.useModernNet": false,
    "clock.alignment": "Right",
    "clock.format": "yyyy/mm/dd HH:MM:ss",
    "vim.ignorecase": false,
    "vim.smartcase": false,
    "redhat.telemetry.enabled": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before" : ["u"],
            "commands" : ["undo"]
        },
        {
            "before" : ["<C-r>"],
            "commands" : ["redo"]
        }
    ],
    "terminal.integrated.shellIntegration.suggestEnabled": false,
    "terminal.integrated.profiles.osx": {
        "bash": {
            "path": "/usr/local/bin/bash",
            "args": [
                "-l"
            ],
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "/usr/local/bin/zsh",
            "args": [
                "-l"
            ]
        },
        "fish": {
            "path": "fish",
            "args": [
                "-l"
            ]
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "[python]": {
        "editor.formatOnType": true
    },
    "editor.codeActionsOnSave": {

    },
    "dart.flutterSdkPath": "/Users/tanish_kr/tool/flutter",
    "[ruby]": {
        "editor.defaultFormatter": "misogi.ruby-rubocop",
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "editor.rulers": [
            120
        ],
        "editor.semanticHighlighting.enabled": true
    },
    "ruby.rubocop.onSave": false,
    "dotnetAcquisitionExtension.enableTelemetry": false,
    "docker.extension.enableComposeLanguageServer": false,
    "json.schemas": [

    ],
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "explorer.compactFolders": false,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilotcli:",
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.disableLoginPrompt": true,
    "files.associations": {
        "*.rb": "ruby"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "ruby": true
    }
}
